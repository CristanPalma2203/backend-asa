# Copia este archivo a .env y CAMBIA todos los valores. .env no se versiona.

# Entorno de ASP.NET Core dentro del contenedor (Production o Development).
# Con Development además se publican /openapi/v1.json y /scalar.
ASPNETCORE_ENVIRONMENT=Production

# Contraseña de "sa". SQL Server exige 8+ caracteres con mayúsculas, minúsculas, dígitos y símbolos.
# Va dentro de la cadena de conexión: no uses ";" ni "$".
MSSQL_SA_PASSWORD=CAMBIAR-Sa-Passw0rd!

# Clave de firma del JWT, 32 caracteres o más.
JWT_KEY=CAMBIAR-esta-clave-jwt-de-32-caracteres-o-mas

# Contraseñas de los usuarios demo que crea el seed (admin@demo.local y ana.lopez@demo.local).
SEED_ADMIN_PASSWORD=CAMBIAR-Admin-123
SEED_LECTOR_PASSWORD=CAMBIAR-Lector-123
